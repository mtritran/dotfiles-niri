#!/bin/bash

CHOSEN=$(echo -e "🌙 3500K - Vàng Ấm (Ban Đêm)\n⛅ 4500K - Dịu Nhẹ\n☀️ 6500K - Trắng Chuẩn (Ban Ngày)\n❄️ 8000K - Tông Lạnh\n🚫 Tắt Gammastep" | fuzzel -d -p "Chỉnh màu màn hình: ")

case "$CHOSEN" in
    *"3500K"*)
        pkill -9 gammastep 2>/dev/null
        gammastep -O 3500 &
        ;;
    *"4500K"*)
        pkill -9 gammastep 2>/dev/null
        gammastep -O 4500 &
        ;;
    *"6500K"*)
        pkill -9 gammastep 2>/dev/null
        gammastep -O 6500 &
        ;;
    *"8000K"*)25
        pkill -9 gammastep 2>/dev/null
        gammastep -O 25000 &
        ;;
    *"Tắt"*)
        pkill -9 gammastep 2>/dev/null
        ;;
esac
